{
    "$schema": "https://www.schemastore.org/launchsettings.json",
    "profiles":{
        "Benchmarks: Execute": {
            "commandName": "Project",
            "environmentVariables": {
                "HARINEZUMISAMA_BENCHMARKS_RESULTS_DIRECTORY": "$(__X_BenchmarkResultsDirectory)"
            }
        },
        "Benchmarks: List": {
            "commandName": "Project",
            "commandLineArgs": "--list flat",
            "environmentVariables": {
                "HARINEZUMISAMA_BENCHMARKS_RESULTS_DIRECTORY": "$(__X_BenchmarkResultsDirectory)"
            }
        }
    }
}
